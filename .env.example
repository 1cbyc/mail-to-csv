# Copy to .env and fill in values (never commit .env):
#   cp .env.example .env

# --- Yahoo (IMAP) ---
# App password: Yahoo Account Security -> Generate app password
YAHOO_USERNAME=you@yahoo.com
YAHOO_APP_PASSWORD=

# Default mailbox when --mailbox is omitted (INBOX, [Yahoo]/Sent, etc.)
YAHOO_MAILBOX=INBOX

# --- Gmail (OAuth2) ---
# Download from Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# --- Outputs (optional) ---
# All CSV paths are relative to this directory unless you pass an absolute path
OUTPUT_DIR=data

# Default filenames used by Makefile targets (override as needed)
GMAIL_EXPORT_CSV=gmail_sent.csv
GMAIL_QUERY=in:sent "Phrase"
YAHOO_EXPORT_CSV=yahoo_inbox.csv
YAHOO_PHRASE=Phrase
WALLET_EXPORT_CSV=wallet_data.csv
